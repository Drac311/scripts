local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Window = Rayfield:CreateWindow({
    Name = "+1 Muscle to Break Walls",
    LoadingTitle = "Loading...",
    LoadingSubtitle = "Drac's Creation",
    ConfigurationSaving = {
        Enabled = false
    }
})

local Tab = Window:CreateTab("Train")

local TrainEvent = ReplicatedStorage.Remotes.Train
local PunchEvent = ReplicatedStorage.Remotes.Punch

local TrainEnabled = false
local PunchEnabled = false

Tab:CreateToggle({
    Name = "Train x8 por frame",
    CurrentValue = false,
    Flag = "TrainToggle",

    Callback = function(Value)
        TrainEnabled = Value
    end
})

Tab:CreateToggle({
    Name = "Punch x1 por frame",
    CurrentValue = false,
    Flag = "PunchToggle",

    Callback = function(Value)
        PunchEnabled = Value
    end
})

Tab:CreateButton({
    Name = "Rejoin",
    Callback = function()
        local player = Players.LocalPlayer

        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(game.PlaceId, player)
        else
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                game.JobId,
                player
            )
        end
    end
})

RunService.Heartbeat:Connect(function()
    if TrainEnabled then
        for i = 1, 8 do
            TrainEvent:FireServer()
        end
    end

    if PunchEnabled then
        PunchEvent:FireServer("LeftHand")
    end
end)
