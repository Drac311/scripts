-- ============================================================
-- CONFIGURACIÓN
-- ============================================================
local TIDAL_URL  = "https://raw.githubusercontent.com/fluidnarrator30/Tidal-Wave/refs/heads/main/Loader.lua"
local SELF_URL   = "https://raw.githubusercontent.com/Drac311/scripts/refs/heads/main/pvp-qot"
local WAIT_TIME  = 3

-- ============================================================
-- REGISTRAR RE-EJECUCIÓN AL TELEPORTARSE
-- ============================================================
if queue_on_teleport then
    queue_on_teleport(([[
        task.wait(%d)
        loadstring(game:HttpGet("%s", true))()
    ]]):format(WAIT_TIME, SELF_URL))
end

-- ============================================================
-- SERVICIOS
-- ============================================================
local SG  = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")
local GS  = game:GetService("GuiService")
local RS  = game:GetService("ReplicatedStorage")

-- ============================================================
-- PERFILES
-- ============================================================
local PROFILES = {
    PC     = { name = "PC",     TouchEnabled = false, GamepadEnabled = false, KeyboardEnabled = true,  MouseEnabled = true,  TenFoot = false },
    Mobile = { name = "Mobile", TouchEnabled = true,  GamepadEnabled = false, KeyboardEnabled = false, MouseEnabled = false, TenFoot = false },
}

local state = getgenv().__ds_state or {}
getgenv().__ds_state = state

if not state.profile then
    state.profile = PROFILES.PC
end

local UIS_KEYS = { TouchEnabled = true, GamepadEnabled = true, KeyboardEnabled = true, MouseEnabled = true }

-- ============================================================
-- HOOK UIS / GS
-- ============================================================
if not state.hooked then
    local mu = getrawmetatable(UIS)
    local ou = mu.__index
    state.origUISIndex = ou
    setreadonly(mu, false)
    mu.__index = newcclosure(function(self, k)
        if self == UIS and state.profile and UIS_KEYS[k] then
            return state.profile[k]
        end
        return ou(self, k)
    end)
    setreadonly(mu, true)

    local mg = getrawmetatable(GS)
    local og = mg.__index
    state.origGSIndex = og
    setreadonly(mg, false)
    mg.__index = newcclosure(function(self, k)
        if self == GS and state.profile and k == "IsTenFootInterface" then
            return newcclosure(function() return state.profile.TenFoot end)
        end
        return og(self, k)
    end)
    setreadonly(mg, true)

    state.hooked = true
end

-- ============================================================
-- FUNCIONES
-- ============================================================
local function toggleDevice()
    if state.profile.name == "PC" then
        state.profile = PROFILES.Mobile
    else
        state.profile = PROFILES.PC
    end
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Device Spoofer",
            Text  = "Cambiado a \u{2192} " .. state.profile.name,
            Duration = 2,
        })
    end)
end

local tidalBusy = false
local function runTidalWave()
    if tidalBusy then return end
    tidalBusy = true
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Tidal Wave", Text = "Cargando script...", Duration = 2,
        })
    end)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(TIDAL_URL, true))()
        end)
        tidalBusy = false
        if not ok then
            warn("[Tidal Wave] Error:", err)
            pcall(function()
                SG:SetCore("SendNotification", {
                    Title = "Tidal Wave", Text = "Error: " .. tostring(err), Duration = 3,
                })
            end)
        end
    end)
end

-- ============================================================
-- COLA 1v1 (tecla Y) — versión robusta
-- ============================================================
local function queue1v1()
    -- 1) Verificar que la ruta del remoto existe
    local Event
    local ok, err = pcall(function()
        Event = RS:WaitForChild("MainRS", 2)
                    :WaitForChild("Remotes", 2)
                    :WaitForChild("MatchmakingRemotes", 2)
                    :WaitForChild("MatchmakingRequest", 2)
    end)

    if not ok or not Event then
        warn("[Matchmaking] No se encontró el RemoteEvent. Ruta:")
        warn("ReplicatedStorage.MainRS.Remotes.MatchmakingRemotes.MatchmakingRequest")
        pcall(function()
            SG:SetCore("SendNotification", {
                Title = "Matchmaking", Text = "Remoto no encontrado", Duration = 3,
            })
        end)
        return
    end

    -- 2) Intento 1: FireServer directo
    local fired = false
    local ok1 = pcall(function()
        Event:FireServer("Queue", "1v1")
        fired = true
    end)

    -- 3) Intento 2: __namecall (fallback si el executor bloquea FireServer)
    if not fired then
        local ok2 = pcall(function()
            local mt = getrawmetatable(game)
            local oldNamecall = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if self == Event and method == "FireServer" then
                    return oldNamecall(self, ...)
                end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)
            -- Forzar el namecall
            local _ = Event.FireServer
            Event["FireServer"](Event, "Queue", "1v1")
            fired = true
        end)
        if not ok2 then
            warn("[Matchmaking] __namecall fallback también falló")
        end
    end

    -- 4) Notificación
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Matchmaking",
            Text  = fired and "Encolado 1v1" or "Error al encolar",
            Duration = 2,
        })
    end)

    if not fired then
        warn("[Matchmaking] Error:", err)
    end
end

-- ============================================================
-- EXTERMINIO PROPIO (tecla H)
-- ============================================================
local function exterminateSelf()
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Exterminio", Text = "Cerrando este script...", Duration = 2,
        })
    end)

    if state.connection then
        pcall(function() state.connection:Disconnect() end)
        state.connection = nil
    end

    if state.origUISIndex then
        pcall(function()
            local mu = getrawmetatable(UIS)
            setreadonly(mu, false)
            mu.__index = state.origUISIndex
            setreadonly(mu, true)
        end)
    end

    if state.origGSIndex then
        pcall(function()
            local mg = getrawmetatable(GS)
            setreadonly(mg, false)
            mg.__index = state.origGSIndex
            setreadonly(mg, true)
        end)
    end

    if queue_on_teleport then
        pcall(function() queue_on_teleport("") end)
    end

    getgenv().__ds_state = nil
    state = {}

    pcall(function() getgenv().DeviceSpoofer = nil end)
    if getgenv_device ~= nil then getgenv_device = nil end

    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Exterminio", Text = "Script cerrado", Duration = 2,
        })
    end)
end

-- ============================================================
-- HOTKEYS
-- ============================================================
if state.connection then
    state.connection:Disconnect()
end

state.connection = UIS.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- Para Y no filtramos gameProcessed, así funciona incluso
    -- con la GUI de Tidal Wave abierta o el chat activo.
    if input.KeyCode == Enum.KeyCode.Y then
        queue1v1()
        return
    end

    -- El resto sí respeta gameProcessed
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.U then
        toggleDevice()
    elseif input.KeyCode == Enum.KeyCode.J then
        runTidalWave()
    elseif input.KeyCode == Enum.KeyCode.H then
        exterminateSelf()
    end
end)

-- ============================================================
-- NOTIFICACIÓN INICIAL + API
-- ============================================================
pcall(function()
    SG:SetCore("SendNotification", {
        Title = "Script activo",
        Text  = "U=Disp | J=Tidal | Y=1v1 | H=Cerrar",
        Duration = 5,
    })
end)

local API = {
    Active      = function() return state.profile and state.profile.name or "None" end,
    Toggle      = toggleDevice,
    SetPC       = function() state.profile = PROFILES.PC     end,
    SetMobile   = function() state.profile = PROFILES.Mobile end,
    RunTidal    = runTidalWave,
    Queue1v1    = queue1v1,
    Exterminate = exterminateSelf,
    SelfURL     = SELF_URL,
    WaitTime    = WAIT_TIME,
}

getgenv().DeviceSpoofer = API
getgenv_device          = API
return API
