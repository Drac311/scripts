local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Drac311/lib/refs/heads/main/DraxiLib.lua"))()

local TIDAL_URL  = "https://raw.githubusercontent.com/fluidnarrator30/Tidal-Wave/refs/heads/main/Loader.lua"
local SELF_URL   = "https://raw.githubusercontent.com/Drac311/scripts/refs/heads/main/pvp-qot"
local WAIT_TIME  = 3
local KICK_REASON = "Drac's Script - Bye!"

if queue_on_teleport then
    queue_on_teleport(([[
        task.wait(%d)
        loadstring(game:HttpGet("%s", true))()
    ]]):format(WAIT_TIME, SELF_URL))
end

local SG  = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")
local GS  = game:GetService("GuiService")
local RS  = game:GetService("ReplicatedStorage")
local PS  = game:GetService("Players")

local PROFILES = {
    PC     = { name = "PC",     TouchEnabled = false, GamepadEnabled = false, KeyboardEnabled = true,  MouseEnabled = true,  TenFoot = false },
    Mobile = { name = "Mobile", TouchEnabled = true,  GamepadEnabled = false, KeyboardEnabled = false, MouseEnabled = false, TenFoot = false },
}

local state = getgenv().__ds_state or {}
getgenv().__ds_state = state

if not state.profile then
    state.profile = PROFILES.PC
end

local UIS_KEYS = { TouchEnabled = true, GamepadEnabled = true, KeyboardEnabled = true, MouseEnabled = true }

if not state.hooked then
    local mu = getrawmetatable(UIS)
    local ou = mu.__index
    state.origUISIndex = ou
    setreadonly(mu, false)
    mu.__index = newcclosure(function(self, k)
        if self == UIS and state.profile and UIS_KEYS[k] then
            return state.profile[k]
        end
        return ou(self, k)
    end)
    setreadonly(mu, true)

    local mg = getrawmetatable(GS)
    local og = mg.__index
    state.origGSIndex = og
    setreadonly(mg, false)
    mg.__index = newcclosure(function(self, k)
        if self == GS and state.profile and k == "IsTenFootInterface" then
            return newcclosure(function() return state.profile.TenFoot end)
        end
        return og(self, k)
    end)
    setreadonly(mg, true)

    state.hooked = true
end

local Window = Library:CreateWindow({
    Name = "Deagle Duels",
    Footer = "Join the discord for more updates!",
    Discord = "",
    ToggleText = "DS",
    ToggleScale = 0.8,
    ToggleKey = Enum.KeyCode.RightShift,
    StartVisible = true,
    ConfigName = "DeagleDuels",
    ScriptUrl = SELF_URL,
})

local Tab = Window:CreateTab("Main")

local function setProfile(name)
    state.profile = PROFILES[name] or PROFILES.PC
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Device Spoofer",
            Text  = "Changed to \u{2192} " .. state.profile.name,
            Duration = 2,
        })
    end)
end

local tidalBusy = false
local function runTidalWave()
    if tidalBusy then return end
    tidalBusy = true
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Tidal Wave", Text = "Loading script...", Duration = 2,
        })
    end)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(TIDAL_URL, true))()
        end)
        tidalBusy = false
        if not ok then
            warn("[Tidal Wave] Error:", err)
        end
    end)
end

local function queue1v1()
    local Event
    local ok = pcall(function()
        Event = RS:WaitForChild("MainRS", 5)
                    :WaitForChild("Remotes", 5)
                    :WaitForChild("MatchmakingRemotes", 5)
                    :WaitForChild("MatchmakingRequest", 5)
    end)

    if not ok or not Event or not Event:IsA("RemoteEvent") then
        warn("[1v1] MatchmakingRequest not found")
        pcall(function()
            SG:SetCore("SendNotification", {
                Title = "1v1", Text = "Remote not found", Duration = 3,
            })
        end)
        return
    end

    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if self == Event and (method == "FireServer" or method == "fireServer") then
            return oldNamecall(self, ...)
        end
        return oldNamecall(self, ...)
    end)

    local fired, err = pcall(function()
        Event:FireServer("Queue", "1v1")
    end)

    mt.__namecall = oldNamecall
    setreadonly(mt, true)

    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "1v1",
            Text  = fired and "Queued" or ("Error: " .. tostring(err)),
            Duration = 2,
        })
    end)

    if not fired then
        warn("[1v1] Error firing FireServer:", err)
    end
end

local function kickSelf()
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Kick", Text = "Leaving the server...", Duration = 2,
        })
    end)

    task.wait(0.3)

    local plr = PS.LocalPlayer
    if not plr then return end

    local ok = pcall(function()
        plr:Kick(KICK_REASON)
    end)

    if ok then return end

    pcall(function()
        coroutine.wrap(function()
            error("Forced disconnect by Drac's Script")
        end)()
    end)

    pcall(function()
        game:Shutdown()
    end)
end

local function restoreHooks()
    if state.connection then
        pcall(function() state.connection:Disconnect() end)
        state.connection = nil
    end

    if state.origUISIndex then
        pcall(function()
            local mu = getrawmetatable(UIS)
            setreadonly(mu, false)
            mu.__index = state.origUISIndex
            setreadonly(mu, true)
        end)
    end

    if state.origGSIndex then
        pcall(function()
            local mg = getrawmetatable(GS)
            setreadonly(mg, false)
            mg.__index = state.origGSIndex
            setreadonly(mg, true)
        end)
    end

    if queue_on_teleport then
        pcall(function() queue_on_teleport("") end)
    end

    getgenv().__ds_state = nil
    state = {}
    pcall(function() getgenv().DeviceSpoofer = nil end)
    if getgenv_device ~= nil then getgenv_device = nil end
end

Tab:CreateLabel("--- Device ---")

Tab:CreateDropdown({
    Name = "Device Profile",
    Options = { "PC", "Mobile" },
    Default = state.profile.name,
    Flag = "DeviceProfile",
    Callback = function(opt)
        setProfile(opt)
    end,
})

Tab:CreateLabel("--- Actions ---")

Tab:CreateButton({
    Name = "Queue 1v1",
    Callback = queue1v1,
})

Tab:CreateButton({
    Name = "Run Tidal Wave",
    Callback = runTidalWave,
})

Tab:CreateButton({
    Name = "Kick Self",
    Callback = kickSelf,
})

Tab:CreateLabel("Hotkeys: [Y] 1v1  [N] Kick  [U] Toggle Device  [J] Tidal  [H] Exterminate")

if state.connection then
    state.connection:Disconnect()
end

state.connection = UIS.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == Enum.KeyCode.Y then
        queue1v1()
        return
    elseif input.KeyCode == Enum.KeyCode.N then
        kickSelf()
        return
    end

    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.U then
        if state.profile.name == "PC" then
            setProfile("Mobile")
        else
            setProfile("PC")
        end
    elseif input.KeyCode == Enum.KeyCode.J then
        runTidalWave()
    elseif input.KeyCode == Enum.KeyCode.H then
        restoreHooks()
        pcall(function() Window:Destroy() end)
    end
end)

pcall(function()
    SG:SetCore("SendNotification", {
        Title    = "Drac's Script",
        Text     = "Enjoy!",
        Duration = 5,
    })
end)

local API = {
    Active      = function() return state.profile and state.profile.name or "None" end,
    SetPC       = function() setProfile("PC")     end,
    SetMobile   = function() setProfile("Mobile") end,
    RunTidal    = runTidalWave,
    Queue1v1    = queue1v1,
    Kick        = kickSelf,
    Exterminate = function()
        restoreHooks()
        pcall(function() Window:Destroy() end)
    end,
    SelfURL     = SELF_URL,
    WaitTime    = WAIT_TIME,
}

getgenv().DeviceSpoofer = API
getgenv_device          = API

Window:OnDestroy(restoreHooks)
