-- [9] PLACE BEST (botón del juego)
-- ============================================================
local function obtenerBotonPlaceBest()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local main = pg:FindFirstChild("Main")
    local tracker = main and main:FindFirstChild("PetsTracker")
    return tracker and tracker:FindFirstChild("PlaceBest")
end

local function pulsarPlaceBest()
    local boton = obtenerBotonPlaceBest()
    if not boton then return false end
    local exito = false
    pcall(function()
        if firesignal then
            firesignal(boton.Activated)
            exito = true
        end
    end)
    return exito
end

-- ============================================================
-- [10] PLACE UNA SOLA MASCOTA (con verificación)
-- ============================================================
local function colocarMascota(petKey, indice)
    local posBase = obtenerPosicionPlot()
    
    -- Distribuir en grid pequeño alrededor de la base
    local offsetX = ((indice - 1) % 5) * 6 - 12
    local offsetZ = math.floor((indice - 1) / 5) * 6 - 6
    local pos = posBase + Vector3.new(offsetX, 5, offsetZ)
    
    pcall(function()
        PlacePet:FireServer(petKey, pos)
    end)
end

local function quitarMascota(petKey)
    pcall(function()
        PickupPet:FireServer(petKey)
    end)
end

-- ============================================================
-- [11] AUTO-EQUIP (VERSIÓN ARREGLADA)
-- ============================================================
local function autoEquipar(usarPotencial, modoDebug)
    if STATE.isAutoEquiping or not STATE.running then 
        print("   ⏸️ Auto-equip en curso o detenido")
        return false
    end
    STATE.isAutoEquiping = true
    
    local modo = usarPotencial and "POTENCIAL" or "ACTUAL"
    print("\n╔══════════════════════════════════════════╗")
    print("║  AUTO-EQUIP: " .. modo .. string.rep(" ", 30 - #modo) .. " ║")
    print("╚══════════════════════════════════════════╝")
    
    -- 1. Leer colocadas actuales
    print("📖 Leyendo colocadas...")
    local colocadas = obtenerColocadas()
    local colocadasKeys = {}
    for _, c in ipairs(colocadas) do 
        colocadasKeys[c.key] = c 
    end
    print("   → " .. #colocadas .. " colocadas ahora")
    
    -- 2. Verificar cache
    local cacheValido = contar(STATE.cache)
    print("   → " .. cacheValido .. " keys en cache")
    
    if cacheValido < 2 then
        print("   ⚠️ Muy pocas keys. Aprende primero.")
        STATE.isAutoEquiping = false
        return false
    end
    
    -- 3. Construir ranking
    local cacheLista = {}
    for key, info in pairs(STATE.cache) do
        if info.name and info.mutation then
            local valor
            if usarPotencial then
                valor = calcularIncomePotencial(info.name, info.mutation)
            else
                valor = calcularIncomeActual(info.name, info.mutation, info.age or 0)
            end
            table.insert(cacheLista, {
                key = key, name = info.name, mutation = info.mutation,
                age = info.age or 0, valor = valor,
            })
        end
    end
    table.sort(cacheLista, function(a, b) return a.valor > b.valor end)
    
    -- 4. Seleccionar mejores N (keys únicas)
    local mejoresN = {}
    local keysUsadas = {}
    for _, c in ipairs(cacheLista) do
        if not keysUsadas[c.key] then
            keysUsadas[c.key] = true
            table.insert(mejoresN, c)
            if #mejoresN >= STATE.slots then break end
        end
    end
    
    print("\n🏆 Mejores " .. #mejoresN .. " seleccionadas:")
    for i, m in ipairs(mejoresN) do
        print(string.format("   %2d. %-14s %-10s Age %3d | %s",
            i, m.name, m.mutation, m.age, formatearDinero(m.valor)))
    end
    
    -- 5. Ver qué hay que cambiar
    local mejoresKeys = {}
    for _, m in ipairs(mejoresN) do mejoresKeys[m.key] = m end
    
    -- Mascotas a quitar (están colocadas pero no en mejores)
    local aQuitar = {}
    for _, c in ipairs(colocadas) do
        if not mejoresKeys[c.key] then
            table.insert(aQuitar, c)
        end
    end
    
    -- Mascotas a poner (están en mejores pero no colocadas)
    local aPoner = {}
    for _, m in ipairs(mejoresN) do
        if not colocadasKeys[m.key] then
            table.insert(aPoner, m)
        end
    end
    
    print("\n📊 Plan:")
    print("   → Quitar: " .. #aQuitar)
    print("   → Poner: " .. #aPoner)
    
    if #aQuitar == 0 and #aPoner == 0 then
        print("\n✅ Ya está óptimo. No hace falta cambiar nada.")
        STATE.isAutoEquiping = false
        return true
    end
    
    -- 6. QUITAR las subóptimas
    if #aQuitar > 0 then
        print("\n🔻 Quitando " .. #aQuitar .. " mascotas...")
        for i, c in ipairs(aQuitar) do
            if not STATE.running then break end
            print("   [" .. i .. "/" .. #aQuitar .. "] Quitando " .. c.name .. " " .. c.mutation .. " ...")
            quitarMascota(c.key)
            task.wait(0.35)
        end
        -- Esperar a que el servidor procese todo
        print("   ⏳ Esperando procesamiento del servidor...")
        task.wait(2)
    end
    
    -- 7. COLOCAR las mejores
    if #aPoner > 0 then
        print("\n🔺 Colocando " .. #aPoner .. " mascotas...")
        local puestas = 0
        for i, m in ipairs(aPoner) do
            if not STATE.running then break end
            print("   [" .. i .. "/" .. #aPoner .. "] Colocando " .. m.name .. " " .. m.mutation .. " ...")
            colocarMascota(m.key, i)
            puestas = puestas + 1
            task.wait(0.5)  -- Delay más largo para asegurar
        end
        print("   ⏳ Esperando procesamiento...")
        task.wait(2)
        
        -- 8. VERIFICAR el resultado
        if CONFIG.VERIFICAR_PLACEMENT then
            print("\n🔍 Verificando resultado...")
            local verificacion = obtenerColocadas()
            local verificacionKeys = {}
            for _, c in ipairs(verificacion) do verificacionKeys[c.key] = true end
            
            local exitosas = 0
            for _, m in ipairs(mejoresN) do
                if verificacionKeys[m.key] then
                    exitosas = exitosas + 1
                end
            end
            
            print("   → Colocadas correctamente: " .. exitosas .. "/" .. #mejoresN)
            
            -- Si menos de la mitad se colocaron, usar fallback
            if exitosas < math.floor(#mejoresN / 2) and CONFIG.USAR_PLACEBEST_FALLBACK then
                print("\n⚠️ Colocación parcial. Usando fallback PlaceBest del juego...")
                if pulsarPlaceBest() then
                    print("   ✅ PlaceBest ejecutado")
                    task.wait(2)
                else
                    print("   ❌ PlaceBest no disponible")
                end
            end
        end
    end
    
    guardarCache()
    print("\n✅ AUTO-EQUIP COMPLETADO")
    STATE.isAutoEquiping = false
    return true
end

