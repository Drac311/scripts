local TabRanking = Window:CreateTab("Ranking", 4483362458)

TabRanking:CreateButton({
    Name = "📊 Top 30 CON Potencial",
    Callback = function()
        local lista = {}
        for key, info in pairs(STATE.cache) do
            if info.name and info.mutation then
                table.insert(lista, {
                    key = key, name = info.name, mutation = info.mutation,
                    age = info.age or 0,
                    valor = calcularIncomePotencial(info.name, info.mutation),
                })
            end
        end
        table.sort(lista, function(a, b) return a.valor > b.valor end)
        print("\n🏆 TOP 30 POTENCIAL (" .. #lista .. " totales):")
        for i = 1, math.min(30, #lista) do
            local p = lista[i]
            print(string.format("%2d. %-14s %-10s Age %3d | %s",
                i, p.name, p.mutation, p.age, formatearDinero(p.valor)))
        end
    end,
})

TabRanking:CreateButton({
    Name = "📊 Top 30 SIN Potencial",
    Callback = function()
        local lista = {}
        for key, info in pairs(STATE.cache) do
            if info.name and info.mutation then
                table.insert(lista, {
                    key = key, name = info.name, mutation = info.mutation,
                    age = info.age or 0,
                    valor = calcularIncomeActual(info.name, info.mutation, info.age or 0),
                })
            end
        end
        table.sort(lista, function(a, b) return a.valor > b.valor end)
        print("\n🏆 TOP 30 ACTUAL (" .. #lista .. " totales):")
        for i = 1, math.min(30, #lista) do
