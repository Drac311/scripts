local function cargarCache()
    pcall(function()
        if readfile and isfile and isfile(CONFIG.ARCHIVO_CACHE) then
            local data = readfile(CONFIG.ARCHIVO_CACHE)
            local decoded = HttpService:JSONDecode(data)
            for k, v in pairs(decoded) do
                if type(v) == "table" and v.name and v.mutation then
                    STATE.cache[k] = v
                end
            end
        end
    end)
end

local function guardarCache()
    pcall(function()
        if writefile then
            writefile(CONFIG.ARCHIVO_CACHE, HttpService:JSONEncode(STATE.cache))
        end
    end)
end

-- ============================================================
-- [5] LEER COLOCADAS (solo cuando hace falta)
-- ============================================================
local function obtenerColocadas()
    local save = nil
    local contador = 0
    
    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            contador = contador + 1
            if contador % 500 == 0 then task.wait() end
            if contador > 30000 then break end
            
            if type(obj) == "table" then
                local count = 0
                pcall(function()
                    for _, v in pairs(obj) do
                        if type(v) == "table" then
                            local pk = v.PetKey
                            local inc = v.Income
                            if type(pk) == "string" and type(inc) == "number" then
                                count = count + 1
                            end
                        end
                        if count > 5 then error("enough") end
                    end
                end)
                if count >= 5 then save = obj break end
            end
        end
    end)
    
    local lista = {}
    if save then
        pcall(function()
            for _, v in pairs(save) do
                if type(v) == "table" then
                    local key = v.PetKey
                    local inc = v.Income
                    if type(key) == "string" and type(inc) == "number" then
                        local info = {
                            key = key,
                            name = tostring(v.Model),
                            mutation = v.Mutation or "-",
                            age = v.CurrentAge or 0,
                            income = inc,
                        }
                        table.insert(lista, info)
                        if not STATE.cache[key] then
                            STATE.cache[key] = {
                                name = info.name,
                                mutation = info.mutation,
                                age = info.age,
                                income = info.income,
                            }
                        end
                    end
                end
            end
        end)
        table.sort(lista, function(a, b) return a.income > b.income end)
    end
    return lista
end

-- ============================================================
-- [6] DETECCIÓN DE REBIRTH
-- ============================================================
local function detectarRebirthDesdeColocadas()
    local colocadas = obtenerColocadas()
    for _, c in ipairs(colocadas) do
        local pData = PetsMod[c.name]
        if pData and pData.Income and pData.Income > 0 then
            local mutF = MutsMod.CombinedFactor(c.mutation) or 1
            local ageF = AgingMod.MultiplierFor(c.age) or 1
            if mutF > 0 and ageF > 0 then
                local r = math.floor(c.income / (pData.Income * mutF * ageF) - 1 + 0.5)
                if r >= 0 then return r end
            end
        end
    end
    return 0
end

-- ============================================================
-- [7] ESCANEO GC
-- ============================================================
local function escanearInventarioAsync(onProgress)
    local antes = contar(STATE.cache)
    local nuevos = 0
    local procesadas = 0
    
    local listaGC = getgc(true)
    local total = #listaGC
    
    local perfil = PERFILES[STATE.perfilEscaneo] or PERFILES["🚶 Normal (lag leve, 20-30s)"]
    local CHUNK = perfil.chunk
    local DELAY = perfil.delay
    
    local i = 1
    local vistos = {}
    
    while i <= total do
        if STATE.cancelarEscaneo then break end
        if procesadas > CONFIG.MAX_TABLAS_ESCANEO then break end
        
        local fin = math.min(i + CHUNK - 1, total)
        
        for j = i, fin do
            local obj = listaGC[j]
            
            if type(obj) == "table" and not vistos[obj] then
                vistos[obj] = true
                procesadas = procesadas + 1
                
                local mtOk, mt = pcall(getmetatable, obj)
                local tieneMT = false
                if mtOk and type(mt) == "table" then
                    local ok_next, first = pcall(next, mt)
                    if ok_next and first ~= nil then tieneMT = true end
                end
                
                if not tieneMT then
                    local numClaves = 0
                    pcall(function()
                        for _ in next, obj do
                            numClaves = numClaves + 1
                            if numClaves > 30 then break end
                        end
                    end)
                    
                    if numClaves > 0 and numClaves <= 30 then
                        pcall(function()
                            local k = obj.key
                            if type(k) ~= "string" or #k ~= 36 then return end
                            local name = obj.name
                            local mut = obj.mutation
                            local age = obj.age
                            local inc = obj.income
                            if type(name) == "string" and type(mut) == "string"
                               and type(age) == "number" and type(inc) == "number" then
                                if k:match(UUID_PATTERN) then
                                    if not STATE.cache[k] then
                                        STATE.cache[k] = {
                                            name = name, mutation = mut,
                                            age = age, income = inc,
                                        }
                                        nuevos = nuevos + 1
                                    else
                                        STATE.cache[k].age = age
                                        STATE.cache[k].income = inc
                                    end
                                end
                            end
                        end)
                    end
                end
            end
        end
        
        i = fin + 1
        task.wait(DELAY)
        if onProgress then onProgress(i, total, nuevos) end
    end
    
    return { antes = antes, despues = contar(STATE.cache), nuevos = nuevos }
end

-- ============================================================
-- [8] CÁLCULOS
-- ============================================================
local function calcularIncomeActual(nombre, mutacion, edad)
    local pData = PetsMod[nombre]
    if not pData or not pData.Income then return 0 end
    local mutF = 1
    if mutacion and mutacion ~= "-" then
        local ok, f = pcall(MutsMod.CombinedFactor, mutacion)
        if ok and f then mutF = f end
    end
    local ageF = AgingMod.MultiplierFor(edad) or 1
    return pData.Income * mutF * ageF * STATE.rebirthMult
end

local function calcularIncomePotencial(nombre, mutacion)
    local pData = PetsMod[nombre]
    if not pData or not pData.Income then return 0 end
    local mutF = 1
    if mutacion and mutacion ~= "-" then
        local ok, f = pcall(MutsMod.CombinedFactor, mutacion)
        if ok and f then mutF = f end
    end
    local ageF100 = AgingMod.MultiplierFor(100) or 1.99
    return pData.Income * mutF * ageF100 * STATE.rebirthMult
end

