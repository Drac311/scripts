TabInicio:CreateSection("Aprendizaje")

local lblProgresoUI = TabInicio:CreateLabel("Estado UI: listo")

TabInicio:CreateButton({
    Name = "🎓 Aprender TODAS vía UI (RÁPIDO ~2min)",
    Callback = function()
        if STATE.isLearning then return end
        STATE.isLearning = true
        STATE.cancelarEscaneo = false
        
        task.spawn(function()
            local stats = aprenderPorUIRapido(function(i, total, capturados)
                pcall(function()
                    lblProgresoUI:Set(string.format("UI %d/%d (%d capturados)", i, total, capturados))
                end)
            end)
            
            pcall(function()
                if stats and stats.error then
                    lblProgresoUI:Set("❌ " .. stats.error)
                else
                    lblProgresoUI:Set("✅ +" .. (stats.nuevos or 0) .. " capturadas")
                    lblCache:Set("💾 Cache: " .. contar(STATE.cache) .. " mascotas")
                    Rayfield:Notify({
                        Title = "✅ Aprendizaje UI",
                        Content = (stats.nuevos or 0) .. " nuevas, total " .. (stats.despues or 0),
                        Duration = 6,
                    })
                end
            end)
            STATE.isLearning = false
        end)
    end,
})

TabInicio:CreateButton({
    Name = "🛑 Cancelar operación",
    Callback = function()
        STATE.cancelarEscaneo = true
    end,
})

local lblProgresoGC = TabInicio:CreateLabel("Estado GC: listo")

TabInicio:CreateButton({
    Name = "🔍 Escanear memoria (solo colocadas)",
    Callback = function()
        if STATE.isLearning then return end
        STATE.isLearning = true
        STATE.cancelarEscaneo = false
        
        task.spawn(function()
            local stats = escanearInventarioAsync(function(i, total, nuevos)
                pcall(function()
                    lblProgresoGC:Set(string.format("GC %d/%d (%d nuevas)", i, total, nuevos))
                end)
            end)
            guardarCache()
            pcall(function()
                lblCache:Set("💾 Cache: " .. stats.despues .. " mascotas")
                lblProgresoGC:Set("✅ +" .. stats.nuevos)
            end)
            STATE.isLearning = false
        end)
    end,
})

