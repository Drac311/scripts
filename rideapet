-- ============================================================
local function obtenerGrid()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local bg = pg:FindFirstChild("BackpackGui")
    bg = bg and bg:FindFirstChild("Backpack")
    bg = bg and bg:FindFirstChild("Inventory")
    if not bg then return nil end
    for _, obj in ipairs(bg:GetDescendants()) do
        if obj.Name == "UIGridFrame" then return obj end
    end
    return nil
end

local function aprenderPorUIRapido(onProgress)
    local grid = obtenerGrid()
    if not grid then
        return {error = "Grid no encontrado. Abre la UI de inventario."}
    end
    
    -- Recolectar items
    local items = {}
    for _, item in ipairs(grid:GetChildren()) do
        if item:IsA("TextButton") then
            table.insert(items, item)
        end
    end
    
    local total = #items
    local antes = contar(STATE.cache)
    local capturados = 0
    local keysDeEsteAprendizaje = {}  -- Trackear las keys que capturamos aquí
    
    print("\n🎓 APRENDIZAJE RÁPIDO v2: " .. total .. " items")
    print("   ⚡ Velocidad: " .. CONFIG.VELOCIDAD_UI .. "s por paso")
    print("   📊 Tiempo estimado: " .. math.floor(total * CONFIG.VELOCIDAD_UI * 3) .. " segundos")
    print("")
    
    -- Limpiar rancho UNA vez al inicio para tener espacio
    print("🧹 Limpiando rancho inicial...")
    local colocadasIniciales = obtenerColocadas()
    for _, c in ipairs(colocadasIniciales) do
        if not STATE.running then break end
        pcall(function() PickupPet:FireServer(c.key) end)
        task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
    end
    task.wait(0.5)
    
    -- ══════════════════════════════════════════════════════════
    -- LOOP PRINCIPAL RÁPIDO
    -- ══════════════════════════════════════════════════════════
    for idx, item in ipairs(items) do
        if not STATE.running or STATE.cancelarEscaneo then break end
        
        -- Reset flag
        STATE.ultimaPetKeyDetectada = nil
        
        -- PASO 1: Click en el item (mascota → mano)
        pcall(function()
            if firesignal then
                firesignal(item.MouseButton1Click)
            end
        end)
        
        task.wait(CONFIG.VELOCIDAD_UI)
        
        -- PASO 2: Click en el suelo (soltar mascota → dispara PlacePet)
        pcall(function()
            if mousemoveabs and mouse1click and workspace.CurrentCamera then
                local plot = game.Workspace:FindFirstChild("Plots")
                plot = plot and plot:FindFirstChild("Plot")
                if plot then
                    local bp = plot:FindFirstChild("Baseplate")
                    if bp and bp:IsA("BasePart") then
                        local posPlot = bp.Position + Vector3.new(0, 5, 0)
                        local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(posPlot)
                        if onScreen then
                            mousemoveabs(screenPos.X, screenPos.Y)
                            task.wait(0.02)
                            mouse1click()
                        end
                    end
                end
            end
        end)
        
        -- PASO 3: Esperar a que el hook capture la key
        task.wait(CONFIG.VELOCIDAD_UI)
        
        -- PASO 4: Registrar la key capturada
        local keyCapturada = STATE.ultimaPetKeyDetectada
        if keyCapturada then
            if not keysDeEsteAprendizaje[keyCapturada] then
                keysDeEsteAprendizaje[keyCapturada] = true
                
                -- Ver si ya estaba en cache antes
                local yaExistia = STATE.cache[keyCapturada] and STATE.cache[keyCapturada].name
                if not yaExistia then
                    capturados = capturados + 1
                    -- No tenemos el nombre/mutación aún, los sacaremos del getgc
                    STATE.cache[keyCapturada] = STATE.cache[keyCapturada] or {}
                    STATE.cache[keyCapturada].lastSeen = os.time()
                end
            end
            
            -- PASO 5: Quitar SOLO la key que acabamos de capturar
            pcall(function() PickupPet:FireServer(keyCapturada) end)
            task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        else
            -- No se capturó ninguna key, limpiar por si acaso
            pcall(function()
                for _, c in ipairs(STATE.keysColocadasPorMi) do
                    PickupPet:FireServer(c)
                end
            end)
        end
        
        if onProgress then
            onProgress(idx, total, capturados)
        end
    end
    
    -- ══════════════════════════════════════════════════════════
    -- ENRIQUECER CACHE CON NOMBRES/MUTACIONES (una sola pasada)
    -- ══════════════════════════════════════════════════════════
    print("\n📝 Enriqueciendo cache con nombres y mutaciones...")
    print("   (una sola pasada de getgc, no por item)")
    
    local enriquecidos = 0
    pcall(function()
        local count = 0
        for _, obj in ipairs(getgc(true)) do
            count = count + 1
            if count > 50000 then break end
            if count % 500 == 0 then task.wait() end
            
            if type(obj) == "table" then
                pcall(function()
                    local k = obj.key
                    if type(k) == "string" and #k == 36 and STATE.cache[k] then
                        local name = obj.name
                        local mut = obj.mutation
                        local age = obj.age
                        local inc = obj.income
                        
                        if type(name) == "string" and type(mut) == "string"
                           and type(age) == "number" and type(inc) == "number" then
                            if not STATE.cache[k].name then
                                STATE.cache[k] = {
                                    name = name, mutation = mut,
                                    age = age, income = inc,
                                }
                                enriquecidos = enriquecidos + 1
                            else
                                STATE.cache[k].age = age
                                STATE.cache[k].income = inc
                            end
                        end
                    end
                end)
            end
        end
    end)
    
    -- Contar cuántas keys quedaron sin nombre
    local sinNombre = 0
    for k, v in pairs(STATE.cache) do
        if not v.name or v.name == "" then
            sinNombre = sinNombre + 1
        end
    end
    
    -- Limpiar las keys sin nombre (basura)
    for k, v in pairs(STATE.cache) do
        if not v.name or v.name == "" then
            STATE.cache[k] = nil
        end
    end
    
    guardarCache()
    
    print("\n╔══════════════════════════════════════════╗")
    print("║  ✅ APRENDIZAJE COMPLETADO               ║")
    print("╚══════════════════════════════════════════╝")
    print("   Nuevas capturadas: " .. capturados)
    print("   Enriquecidas: " .. enriquecidos)
    print("   Sin nombre (limpiadas): " .. sinNombre)
    print("   Total cache final: " .. contar(STATE.cache))
    
    return {
        antes = antes,
        despues = contar(STATE.cache),
        nuevos = contar(STATE.cache) - antes,
    }
end

