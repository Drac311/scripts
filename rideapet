local capturados = 0

-- Hookear TODOS los RemoteEvents (excepto los que spamean)
local eventosIgnorados = {
    PetCollect = true,
    EggPlaced = true,
    RadarState = true,
    PetFed = true,
}

local ok = pcall(function()
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local m = getnamecallmethod()
        
        if m == "FireServer" and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
            if not eventosIgnorados[self.Name] then
                local args = {...}
                capturados = capturados + 1
                
                print("\n[🔥 #" .. capturados .. "] " .. self.Name)
                for i, v in ipairs(args) do
                    if type(v) == "table" then
                        local claves = {}
                        local n = 0
                        for k, _ in pairs(v) do
                            n = n + 1
                            if n <= 10 then table.insert(claves, tostring(k)) end
                        end
                        print("   arg[" .. i .. "] (tabla): " .. table.concat(claves, ", "))
                    else
                        local s = tostring(v)
                        if #s > 80 then s = s:sub(1, 80) .. "..." end
                        print("   arg[" .. i .. "] (" .. type(v) .. ") = " .. s)
                    end
                end
            end
        end
        
        return oldNC(self, ...)
    end)
    
    setreadonly(mt, true)
end)

if not ok then
    print("❌ Hook falló")
    return
end

print("🎣 Hook activo. Esperando 40 segundos...\n")

task.wait(40)

print("\n═══════════════════════════════════════════")
