-- ============================================================
-- [3] UTILIDADES
-- ============================================================
local function contar(t)
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end

local function formatearDinero(n)
    if type(n) ~= "number" then return "0" end
    if n >= 1e15 then return string.format("%.2fQ", n/1e15)
    elseif n >= 1e12 then return string.format("%.2fT", n/1e12)
    elseif n >= 1e9 then return string.format("%.2fB", n/1e9)
    elseif n >= 1e6 then return string.format("%.2fM", n/1e6)
    elseif n >= 1e3 then return string.format("%.2fK", n/1e3)
    else return string.format("%.0f", n) end
end

-- ============================================================
-- [4] CACHE
-- ============================================================
local function cargarCache()
    pcall(function()
        if readfile and isfile and isfile(CONFIG.ARCHIVO_CACHE) then
            local data = readfile(CONFIG.ARCHIVO_CACHE)
            local decoded = HttpService:JSONDecode(data)
            for k, v in pairs(decoded) do
                if type(v) == "table" and v.name and v.mutation then
                    STATE.cache[k] = v
                end
            end
        end
    end)
end

local function guardarCache()
    pcall(function()
        local limpio = {}
        for k, v in pairs(STATE.cache) do
            if v.name and v.mutation then
                limpio[k] = {
                    name = v.name,
                    mutation = v.mutation,
                    age = v.age or 0,
                    income = v.income or 0,
                }
            end
        end
        if writefile then
            writefile(CONFIG.ARCHIVO_CACHE, HttpService:JSONEncode(limpio))
        end
    end)
end

-- ============================================================
-- [5] LEER COLOCADAS
-- ============================================================
local function obtenerColocadas()
    local save = nil
    local contador = 0
    
    pcall(function()
        for _, obj in ipairs(getgc(true)) do
            contador = contador + 1
            if contador % 500 == 0 then task.wait() end
            if contador > 30000 then break end
            
            if type(obj) == "table" then
                local count = 0
                pcall(function()
                    for _, v in pairs(obj) do
                        if type(v) == "table" then
                            local pk = v.PetKey
                            local inc = v.Income
                            if type(pk) == "string" and type(inc) == "number" then
                                count = count + 1
                            end
                        end
                        if count > 3 then error("enough") end
                    end
                end)
                if count >= 3 then save = obj break end
            end
        end
    end)
    
    local lista = {}
    if save then
        pcall(function()
            for _, v in pairs(save) do
                if type(v) == "table" then
                    local key = v.PetKey
                    local inc = v.Income
                    if type(key) == "string" and type(inc) == "number" then
                        local info = {
                            key = key,
                            name = tostring(v.Model),
                            mutation = v.Mutation or "-",
                            age = v.CurrentAge or 0,
                            income = inc,
                        }
                        table.insert(lista, info)
                        if not STATE.cache[key] or not STATE.cache[key].name then
                            STATE.cache[key] = {
                                name = info.name,
                                mutation = info.mutation,
                                age = info.age,
                                income = info.income,
                            }
                        end
                    end
                end
            end
        end)
        table.sort(lista, function(a, b) return a.income > b.income end)
    end
    return lista
end

-- ============================================================
-- [6] DETECCIÓN REBIRTH
-- ============================================================
local function detectarRebirthDesdeColocadas()
    local colocadas = obtenerColocadas()
    for _, c in ipairs(colocadas) do
        local pData = PetsMod[c.name]
        if pData and pData.Income and pData.Income > 0 then
            local mutF = MutsMod.CombinedFactor(c.mutation) or 1
            local ageF = AgingMod.MultiplierFor(c.age) or 1
            if mutF > 0 and ageF > 0 then
                local r = math.floor(c.income / (pData.Income * mutF * ageF) - 1 + 0.5)
                if r >= 0 then return r end
            end
        end
    end
    return 0
end

-- ============================================================
-- [7] CÁLCULOS
-- ============================================================
local function calcularIncomeActual(nombre, mutacion, edad)
    local pData = PetsMod[nombre]
    if not pData or not pData.Income then return 0 end
    local mutF = 1
    if mutacion and mutacion ~= "-" then
        local ok, f = pcall(MutsMod.CombinedFactor, mutacion)
        if ok and f then mutF = f end
    end
    local ageF = AgingMod.MultiplierFor(edad) or 1
    return pData.Income * mutF * ageF * STATE.rebirthMult
end

local function calcularIncomePotencial(nombre, mutacion)
    local pData = PetsMod[nombre]
    if not pData or not pData.Income then return 0 end
    local mutF = 1
    if mutacion and mutacion ~= "-" then
        local ok, f = pcall(MutsMod.CombinedFactor, mutacion)
        if ok and f then mutF = f end
    end
    local ageF100 = AgingMod.MultiplierFor(100) or 1.99
    return pData.Income * mutF * ageF100 * STATE.rebirthMult
end

