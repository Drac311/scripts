-- [10] HOOKS
-- ============================================================
local function instalarHooks()
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNC = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "FireServer" and (self == PlacePet or self == PickupPet) then
                local args = {...}
                for i, v in ipairs(args) do
                    if type(v) == "string" and v:match(UUID_PATTERN) then
                        if not STATE.cache[v] then STATE.cache[v] = {} end
                        STATE.cache[v].lastSeen = os.time()
                        
                        -- Capturar la key del PlacePet para el aprendizaje UI
                        if self == PlacePet and i == 1 then
                            STATE.ultimaPetKeyDetectada = v
                        end
                    end
                end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
    end)
    
    pcall(function()
        PlacePet.OnClientEvent:Connect(function(...)
            for _, v in ipairs({...}) do
                if type(v) == "string" and v:match(UUID_PATTERN) then
                    if not STATE.cache[v] then STATE.cache[v] = {} end
                    STATE.cache[v].lastSeen = os.time()
                end
            end
        end)
        PickupPet.OnClientEvent:Connect(function(...)
            for _, v in ipairs({...}) do
                if type(v) == "string" and v:match(UUID_PATTERN) then
                    if not STATE.cache[v] then STATE.cache[v] = {} end
                    STATE.cache[v].lastSeen = os.time()
                end
            end
        end)
    end)
end

