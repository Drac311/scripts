-- [14] APRENDER 1 ITEM
-- ============================================================
local function aprenderUnItem(item)
    if not item then return false, "Item inválido" end
    
    STATE.ultimaPetKeyDetectada = nil
    local nombre, mutacion = obtenerDatosDeItem(item)
    
    pcall(function()
        if firesignal then firesignal(item.MouseButton1Click) end
    end)
    task.wait(CONFIG.VELOCIDAD_UI)
    
    pcall(function()
        if mousemoveabs and mouse1click and workspace.CurrentCamera then
            local posBase = STATE.posBasePlot or Vector3.new(0, 0, 0)
            local posPlot = posBase + Vector3.new(0, 5, 0)
            local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(posPlot)
            if onScreen then
                mousemoveabs(screenPos.X, screenPos.Y)
                task.wait(0.05)
                mouse1click()
            end
        end
    end)
    task.wait(CONFIG.VELOCIDAD_UI)
    
    local keyCapturada = STATE.ultimaPetKeyDetectada
    
    if keyCapturada then
        local esNueva = not STATE.cache[keyCapturada] or not STATE.cache[keyCapturada].name
        STATE.cache[keyCapturada] = {
            name = nombre or "Desconocido",
            mutation = mutacion or "-",
            age = STATE.cache[keyCapturada] and STATE.cache[keyCapturada].age or 0,
            income = STATE.cache[keyCapturada] and STATE.cache[keyCapturada].income or 0,
        }
        pcall(function() PickupPet:FireServer(keyCapturada) end)
        task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        return true, (esNueva and "NUEVA" or "act") .. ": " .. (nombre or "?")
    else
        local colocadas = obtenerColocadas()
        for _, c in ipairs(colocadas) do
            pcall(function() PickupPet:FireServer(c.key) end)
            task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        end
        return false, "No capturada"
    end
end

-- ============================================================
-- [15] APRENDER TODOS VÍA UI
-- ============================================================
local function aprenderPorUIRapido(onProgress, limite)
    local grid = obtenerGrid()
    if not grid then
        return {error = "Grid no encontrado. Abre la UI de inventario."}
    end
    
    if not STATE.posBasePlot then
        detectarPosicionPlot()
    end
    
    local items = {}
    for _, item in ipairs(grid:GetChildren()) do
        if item:IsA("TextButton") then table.insert(items, item) end
    end
    
    local desde = STATE.indiceAprendizaje + 1
    local hasta = limite and math.min(desde + limite - 1, #items) or #items
    
    if desde > #items then
        desde = 1
        STATE.indiceAprendizaje = 0
        hasta = limite and math.min(limite, #items) or #items
    end
    
    local total = #items
    local antes = contar(STATE.cache)
    local capturados = 0
    
    print("\n🎓 APRENDIZAJE UI: items " .. desde .. " a " .. hasta .. " de " .. total)
    
    if desde == 1 then
        print("🧹 Limpiando rancho...")
        local colocadasIniciales = obtenerColocadas()
        for _, c in ipairs(colocadasIniciales) do
            if not STATE.running then break end
            pcall(function() PickupPet:FireServer(c.key) end)
            task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        end
        task.wait(0.5)
    end
    
    for idx = desde, hasta do
        if not STATE.running or STATE.cancelarEscaneo then break end
        local item = items[idx]
        if item then
            local ok, msg = aprenderUnItem(item)
            if ok then capturados = capturados + 1 end
        end
        STATE.indiceAprendizaje = idx
        
        if idx % CONFIG.GUARDAR_CADA == 0 then
            guardarCache()
            print("   💾 Auto-guardado (" .. idx .. "/" .. total .. ") | Cache: " .. contar(STATE.cache))
        end
        
        if onProgress then onProgress(idx, total, capturados) end
    end
    
    print("\n📝 Enriqueciendo age/income...")
    pcall(function()
        local count = 0
        for _, obj in ipairs(getgc(true)) do
            count = count + 1
            if count > 50000 then break end
            if count % 500 == 0 then task.wait() end
            if type(obj) == "table" then
                pcall(function()
                    local k = obj.key
                    if type(k) == "string" and #k == 36 and STATE.cache[k] then
                        local age = obj.age
                        local inc = obj.income
                        if type(age) == "number" and type(inc) == "number" then
                            STATE.cache[k].age = age
                            STATE.cache[k].income = inc
                        end
                    end
                end)
            end
        end
    end)
    
    guardarCache()
    local finalCache = contar(STATE.cache)
    print("\n✅ Completado. Capturados: " .. capturados .. " | Cache: " .. finalCache)
    
    if hasta >= total then STATE.indiceAprendizaje = 0 end
    
    return { antes = antes, despues = finalCache, nuevos = finalCache - antes }
end

