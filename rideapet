local eventosIgnorados = {
    PetCollect = true,
    EggPlaced = true,
    RadarState = true,
    PetFed = true,
    PetMove = true,
}

local function iniciarDiagnostico(duracionSegundos)
    if STATE.diagnosticActivo then return end
    STATE.diagnosticActivo = true
    STATE.diagnosticCapturas = {}
    
    print("\n╔══════════════════════════════════════════╗")
    print("║  DIAGNÓSTICO INICIADO (" .. duracionSegundos .. "s)          ║")
    print("╚══════════════════════════════════════════╝")
    print("👉 HAZ AHORA:")
    print("   1. Abre el inventario")
    print("   2. Click en una mascota (se queda en la mano)")
    print("   3. Click en el suelo para soltarla")
    print("   4. Repite 2-3 veces")
    
    local capturados = 0
    
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        local oldNC = mt.__namecall
        setreadonly(mt, false)
        
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            
            if m == "FireServer" and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                if not eventosIgnorados[self.Name] and STATE.diagnosticActivo then
                    local args = {...}
                    capturados = capturados + 1
                    
                    local info = {
                        numero = capturados,
                        nombre = self.Name,
                        args = {},
                    }
                    
                    local lineas = {"[🔥 #" .. capturados .. "] " .. self.Name}
                    for i, v in ipairs(args) do
                        if type(v) == "table" then
                            local claves = {}
                            local n = 0
                            for k, _ in pairs(v) do
                                n = n + 1
                                if n <= 8 then table.insert(claves, tostring(k)) end
                            end
                            table.insert(info.args, {tipo = "table", claves = claves})
                            table.insert(lineas, "   arg[" .. i .. "] (tabla): " .. table.concat(claves, ", "))
                        else
                            local s = tostring(v)
                            table.insert(info.args, {tipo = type(v), valor = s:sub(1, 80)})
                            if #s > 80 then s = s:sub(1, 80) .. "..." end
                            table.insert(lineas, "   arg[" .. i .. "] (" .. type(v) .. ") = " .. s)
                        end
                    end
                    
                    table.insert(STATE.diagnosticCapturas, info)
                    print(table.concat(lineas, "\n"))
                end
            end
            
            return oldNC(self, ...)
        end)
        
        setreadonly(mt, true)
    end)
    
    if not ok then
        print("❌ Hook falló")
        STATE.diagnosticActivo = false
        return
    end
    
    task.spawn(function()
        task.wait(duracionSegundos)
        STATE.diagnosticActivo = false
        
        print("\n╔══════════════════════════════════════════╗")
        print("║  DIAGNÓSTICO TERMINADO                   ║")
        print("╚══════════════════════════════════════════╝")
        print("Total remotes capturados: " .. #STATE.diagnosticCapturas)
        
        -- Contar por nombre
        local porNombre = {}
        for _, c in ipairs(STATE.diagnosticCapturas) do
            porNombre[c.nombre] = (porNombre[c.nombre] or 0) + 1
        end
        
        print("\nRemotes capturados:")
        for nombre, cuenta in pairs(porNombre) do
            print("   " .. nombre .. ": " .. cuenta .. " veces")
        end
        
        pcall(function()
            Rayfield:Notify({
                Title = "✅ Diagnóstico terminado",
                Content = #STATE.diagnosticCapturas .. " remotes capturados. Mira la consola.",
                Duration = 8,
            })
        end)
    end)
end

