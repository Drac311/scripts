local TabAuto = Window:CreateTab("Auto Equip", 4483362458)
TabAuto:CreateSection("Modo de Auto-Equipado")

local toggleActualRef = nil
local togglePotencialRef = nil

toggleActualRef = TabAuto:CreateToggle({
    Name = "⚡ Auto Equip SIN Potencial (Income actual)",
    CurrentValue = false,
    Flag = "AutoActual",
    Callback = function(value)
        if value then
            STATE.modoAutoEquip = "actual"
            if togglePotencialRef then togglePotencialRef:Set(false) end
            task.spawn(function() autoEquipar(false) end)
        else
            if STATE.modoAutoEquip == "actual" then STATE.modoAutoEquip = nil end
        end
    end,
})

togglePotencialRef = TabAuto:CreateToggle({
    Name = "🚀 Auto Equip CON Potencial (Age 100)",
    CurrentValue = false,
    Flag = "AutoPotencial",
    Callback = function(value)
        if value then
            STATE.modoAutoEquip = "potencial"
            if toggleActualRef then toggleActualRef:Set(false) end
            task.spawn(function() autoEquipar(true) end)
        else
            if STATE.modoAutoEquip == "potencial" then STATE.modoAutoEquip = nil end
        end
    end,
})

TabAuto:CreateButton({
    Name = "▶️ Ejecutar ahora",
    Callback = function()
        task.spawn(function()
            autoEquipar(STATE.modoAutoEquip == "potencial")
        end)
    end,
})

TabAuto:CreateButton({
    Name = "🎯 Pulsar 'Place Best' del juego",
    Callback = function()
        pulsarPlaceBest()
    end,
})

