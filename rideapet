-- ============================================================
-- [9] UI HELPERS
-- ============================================================
local function obtenerGrid()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local bg = pg:FindFirstChild("BackpackGui")
    bg = bg and bg:FindFirstChild("Backpack")
    bg = bg and bg:FindFirstChild("Inventory")
    if not bg then return nil end
    for _, obj in ipairs(bg:GetDescendants()) do
        if obj.Name == "UIGridFrame" then return obj end
    end
    return nil
end

local function obtenerDatosDeItem(item)
    local nombre = nil
    local mutacion = "-"
    
    pcall(function()
        local toolName = item:FindFirstChild("ToolName")
        if toolName and toolName:IsA("TextLabel") then
            nombre = toolName.Text:match("^([^%[]+)")
            if nombre then
                nombre = nombre:gsub("^%s+", ""):gsub("%s+$", "")
            end
        end
        local withIcon = item:FindFirstChild("WithIconLabel")
        if withIcon and withIcon:IsA("TextLabel") then
            local m = withIcon.Text:match("%[([^%]]+)%]")
            if m then mutacion = m end
        end
    end)
    
    return nombre, mutacion
end

-- Busca un item en el grid que coincida con nombre + mutación
local function buscarItemEnGrid(nombreBuscado, mutacionBuscada)
    local grid = obtenerGrid()
    if not grid then return nil end
    
    local mejorItem = nil
    local mejorScore = 0
    
    for _, item in ipairs(grid:GetChildren()) do
        if item:IsA("TextButton") then
            local n, m = obtenerDatosDeItem(item)
            if n == nombreBuscado and m == mutacionBuscada then
                -- Preferir items visibles
                local score = item.Visible and 100 or 50
                -- Preferir items con peso bajo (más nuevos)
                if score > mejorScore then
                    mejorItem = item
                    mejorScore = score
                end
                if item.Visible then break end  -- Preferir el primero visible
            end
        end
    end
    
    return mejorItem
end

