-- ============================================================
-- [11] DETECTAR POSICIÓN DEL PLOT
-- ============================================================
local function detectarPosicionPlot()
    local pos = Vector3.new(0, 0, 0)
    
    pcall(function()
        local plots = game.Workspace:FindFirstChild("Plots")
        if plots then
            for _, plot in ipairs(plots:GetChildren()) do
                -- Buscar Baseplate
                local bp = plot:FindFirstChild("Baseplate")
                if not bp then
                    for _, child in ipairs(plot:GetChildren()) do
                        if child:IsA("BasePart") then
                            bp = child
                            break
                        end
                    end
                end
                if bp and bp:IsA("BasePart") then
                    pos = bp.Position
                    print("📍 Plot detectado: " .. tostring(pos) .. " en " .. bp:GetFullName())
                    break
                end
            end
        end
    end)
    
    -- Verificar con mascotas ya colocadas
    local carpetaPets = game.Workspace:FindFirstChild("Plots")
    carpetaPets = carpetaPets and carpetaPets:FindFirstChild("Plot")
    carpetaPets = carpetaPets and carpetaPets:FindFirstChild("Pets")
    
    if carpetaPets then
        local count = 0
        for _, pet in ipairs(carpetaPets:GetChildren()) do
            if pet:IsA("Model") then
                local hrp = pet:FindFirstChild("HumanoidRootPart") or pet.PrimaryPart
                if hrp then
                    pos = hrp.Position
                    count = count + 1
                    if count == 1 then
                        print("📍 Mascota colocada en: " .. tostring(pos))
                    end
                end
            end
        end
        if count > 0 then
            print("   (" .. count .. " mascotas colocadas de referencia)")
        end
    end
    
    STATE.posBasePlot = pos
    return pos
end

-- ============================================================
-- [12] AUTO-EQUIP VÍA UI (funciona con el flujo natural)
-- ============================================================
local function autoEquiparViaUI(usarPotencial)
    if STATE.isAutoEquiping or not STATE.running then return false end
    STATE.isAutoEquiping = true
    
    local modo = usarPotencial and "POTENCIAL" or "ACTUAL"
    print("\n╔══════════════════════════════════════════╗")
    print("║  AUTO-EQUIP vía UI: " .. modo)
    print("╚══════════════════════════════════════════╝")
    
    -- Detectar posición del plot
    if not STATE.posBasePlot then
        detectarPosicionPlot()
    end
    
    -- 1. Leer colocadas
    print("📖 Leyendo colocadas...")
    local colocadas = obtenerColocadas()
    print("   → " .. #colocadas .. " colocadas")
    
    if contar(STATE.cache) < 2 then
        print("   ⚠️ Cache muy pequeño")
        STATE.isAutoEquiping = false
        return false
    end
    
    -- 2. Construir ranking
    local cacheLista = {}
    for key, info in pairs(STATE.cache) do
        if info.name and info.mutation then
            local valor
            if usarPotencial then
                valor = calcularIncomePotencial(info.name, info.mutation)
            else
                valor = calcularIncomeActual(info.name, info.mutation, info.age or 0)
            end
            table.insert(cacheLista, {
                key = key, name = info.name, mutation = info.mutation,
                age = info.age or 0, valor = valor,
            })
        end
    end
    table.sort(cacheLista, function(a, b) return a.valor > b.valor end)
    
    -- 3. Mejores N
    local mejoresN = {}
    local keysUsadas = {}
    for _, c in ipairs(cacheLista) do
        if not keysUsadas[c.key] then
            keysUsadas[c.key] = true
            table.insert(mejoresN, c)
            if #mejoresN >= STATE.slots then break end
        end
    end
    
    print("\n🏆 Mejores " .. #mejoresN .. ":")
    for i, m in ipairs(mejoresN) do
        print(string.format("   %2d. %-14s %-10s | %s",
            i, m.name, m.mutation, formatearDinero(m.valor)))
    end
    
    -- 4. Ver qué cambiar
    local mejoresKeys = {}
    for _, m in ipairs(mejoresN) do mejoresKeys[m.key] = m end
    
    local aQuitar = {}
    for _, c in ipairs(colocadas) do
        if not mejoresKeys[c.key] then
            table.insert(aQuitar, c)
        end
    end
    
    print("\n📊 Plan:")
    print("   → Quitar: " .. #aQuitar)
    print("   → Colocar: " .. #mejoresN)
    
    -- 5. QUITAR TODAS las colocadas (para empezar limpio)
    print("\n🔻 Quitando todas las colocadas...")
    for i, c in ipairs(colocadas) do
        if not STATE.running then break end
        pcall(function() PickupPet:FireServer(c.key) end)
        task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
    end
    task.wait(1.5)
    
    -- Verificar que se quitaron
    local postQuitar = obtenerColocadas()
    print("   → Quedan " .. #postQuitar .. " colocadas")
    
    -- 6. COLOCAR las mejores VÍA UI
    print("\n🔺 Colocando " .. #mejoresN .. " vía UI...")
    local colocadasExito = 0
    local colocadasKeys = {}
    
    for i, m in ipairs(mejoresN) do
        if not STATE.running then break end
        
        print("\n   [" .. i .. "/" .. #mejoresN .. "] " .. m.name .. " " .. m.mutation)
        
        -- Buscar el item en el grid
        local item = buscarItemEnGrid(m.name, m.mutation)
        if not item then
            print("      ⚠️ Item no encontrado en grid")
        else
            print("      📦 Item encontrado, colocando...")
            local keyCapturada = colocarViaUI(item)
            
            if keyCapturada then
                colocadasExito = colocadasExito + 1
                colocadasKeys[keyCapturada] = true
                print("      ✅ Colocada: " .. keyCapturada:sub(1,8))
                
                -- Actualizar cache con la key real
                if STATE.cache[keyCapturada] then
                    STATE.cache[keyCapturada].age = STATE.cache[keyCapturada].age or 0
                end
            else
                print("      ❌ No se capturó la key")
            end
        end
        
        task.wait(CONFIG.VELOCIDAD_PLACE)
    end
    
    -- 7. Verificar
    print("\n🔍 Verificando resultado...")
    task.wait(1)
    local final = obtenerColocadas()
    print("   → " .. #final .. " mascotas colocadas al final")
    
    -- 8. Fallback: si <50% se colocaron, usar PlaceBest
    if colocadasExito < math.floor(#mejoresN / 2) then
        print("\n⚠️ Colocación parcial. Usando PlaceBest del juego...")
        if pulsarPlaceBest() then
            print("   ✅ PlaceBest ejecutado")
            task.wait(2)
            final = obtenerColocadas()
            print("   → " .. #final .. " mascotas colocadas tras PlaceBest")
        end
    end
    
    guardarCache()
    print("\n✅ AUTO-EQUIP COMPLETADO (" .. colocadasExito .. "/" .. #mejoresN .. ")")
    STATE.isAutoEquiping = false
    return true
end

