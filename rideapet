-- [11] APRENDER VÍA UI (con guardado correcto)
-- ============================================================
local function obtenerGrid()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local bg = pg:FindFirstChild("BackpackGui")
    bg = bg and bg:FindFirstChild("Backpack")
    bg = bg and bg:FindFirstChild("Inventory")
    if not bg then return nil end
    for _, obj in ipairs(bg:GetDescendants()) do
        if obj.Name == "UIGridFrame" then return obj end
    end
    return nil
end

local function aprenderPorUIRapido(onProgress)
    local grid = obtenerGrid()
    if not grid then
        return {error = "Grid no encontrado. Abre la UI de inventario."}
    end
    
    local items = {}
    for _, item in ipairs(grid:GetChildren()) do
        if item:IsA("TextButton") then
            table.insert(items, item)
        end
    end
    
    local total = #items
    local antes = contar(STATE.cache)
    local capturados = 0
    local itemsGuardados = 0
    
    print("\n🎓 APRENDIZAJE v13: " .. total .. " items")
    print("   Guardado automático cada " .. CONFIG.GUARDAR_CADA .. " items")
    print("")
    
    -- Limpiar rancho al inicio
    print("🧹 Limpiando rancho...")
    local colocadasIniciales = obtenerColocadas()
    for _, c in ipairs(colocadasIniciales) do
        if not STATE.running then break end
        pcall(function() PickupPet:FireServer(c.key) end)
        task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
    end
    task.wait(0.5)
    
    -- ══════════════════════════════════════════════════════════
    -- LOOP PRINCIPAL
    -- ══════════════════════════════════════════════════════════
    for idx, item in ipairs(items) do
        if not STATE.running or STATE.cancelarEscaneo then break end
        
        -- Reset flags
        STATE.ultimaPetKeyDetectada = nil
        STATE.ultimoNombreUI = nil
        STATE.ultimaMutacionUI = nil
        
        -- ⭐ PASO 1: LEER DATOS DE LA UI ANTES DEL CLICK
        local nombre, mutacion, peso = obtenerDatosDeItem(item)
        STATE.ultimoNombreUI = nombre
        STATE.ultimaMutacionUI = mutacion
        
        -- PASO 2: Click en item (mascota → mano)
        pcall(function()
            if firesignal then
                firesignal(item.MouseButton1Click)
            end
        end)
        
        task.wait(CONFIG.VELOCIDAD_UI)
        
        -- PASO 3: Click en el suelo (soltar mascota)
        pcall(function()
            if mousemoveabs and mouse1click and workspace.CurrentCamera then
                local plot = game.Workspace:FindFirstChild("Plots")
                plot = plot and plot:FindFirstChild("Plot")
                if plot then
                    local bp = plot:FindFirstChild("Baseplate")
                    if bp and bp:IsA("BasePart") then
                        local posPlot = bp.Position + Vector3.new(0, 5, 0)
                        local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(posPlot)
                        if onScreen then
                            mousemoveabs(screenPos.X, screenPos.Y)
                            task.wait(0.02)
                            mouse1click()
                        end
                    end
                end
            end
        end)
        
        -- PASO 4: Esperar a que el hook capture
        task.wait(CONFIG.VELOCIDAD_UI)
        
        local keyCapturada = STATE.ultimaPetKeyDetectada
        
        if keyCapturada then
            -- ⭐ Guardar con datos correctos (ya está hecho en el hook)
            if not STATE.cache[keyCapturada] or not STATE.cache[keyCapturada].name 
               or STATE.cache[keyCapturada].name == "Desconocido" then
                STATE.cache[keyCapturada] = {
                    name = nombre or "Desconocido",
                    mutation = mutacion or "-",
                    age = 0,
                    income = 0,
                }
                capturados = capturados + 1
            end
            
            -- Quitar solo esa mascota
            pcall(function() PickupPet:FireServer(keyCapturada) end)
            task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        else
            -- Fallback: si el hook no capturó, intentar quitar por si acaso
            pcall(function()
                local colocadas = obtenerColocadas()
                for _, c in ipairs(colocadas) do
                    PickupPet:FireServer(c.key)
                end
            end)
            task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        end
        
        -- ⭐ GUARDADO INCREMENTAL cada N items
        if idx % CONFIG.GUARDAR_CADA == 0 then
            guardarCache()
            itemsGuardados = itemsGuardados + 1
            print("   💾 Guardado automático (" .. idx .. "/" .. total .. ") | Cache: " .. contar(STATE.cache))
        end
        
        if onProgress then
            onProgress(idx, total, capturados)
        end
    end
    
    -- ══════════════════════════════════════════════════════════
    -- ENRIQUECIMIENTO FINAL (una pasada)
    -- ══════════════════════════════════════════════════════════
    print("\n📝 Enriqueciendo cache con age/income...")
    
    pcall(function()
        local count = 0
        for _, obj in ipairs(getgc(true)) do
            count = count + 1
            if count > 50000 then break end
            if count % 500 == 0 then task.wait() end
            
            if type(obj) == "table" then
                pcall(function()
                    local k = obj.key
                    if type(k) == "string" and #k == 36 and STATE.cache[k] then
                        local age = obj.age
                        local inc = obj.income
                        if type(age) == "number" and type(inc) == "number" then
                            STATE.cache[k].age = age
                            STATE.cache[k].income = inc
                        end
                    end
                end)
            end
        end
    end)
    
    -- ⭐ GUARDADO FINAL
    guardarCache()
    
    local finalCache = contar(STATE.cache)
    
    print("\n╔══════════════════════════════════════════╗")
    print("║  ✅ APRENDIZAJE COMPLETADO               ║")
    print("╚══════════════════════════════════════════╝")
    print("   Capturadas en esta sesión: " .. capturados)
    print("   Cache final: " .. finalCache)
    print("   Guardado en: " .. CONFIG.ARCHIVO_CACHE)
    
    return {
        antes = antes,
        despues = finalCache,
        nuevos = finalCache - antes,
    }
end

