-- [12] APRENDER TODOS VÍA UI
-- ============================================================
local function aprenderPorUIRapido(onProgress, limite)
    local grid = obtenerGrid()
    if not grid then
        return {error = "Grid no encontrado. Abre la UI de inventario."}
    end
    
    local items = {}
    for _, item in ipairs(grid:GetChildren()) do
        if item:IsA("TextButton") then
            table.insert(items, item)
        end
    end
    
    -- Aplicar límite (para "once" o parcial)
    local desde = STATE.indiceAprendizaje + 1
    local hasta = limite and math.min(desde + limite - 1, #items) or #items
    
    if desde > #items then
        desde = 1
        STATE.indiceAprendizaje = 0
        hasta = limite and math.min(limite, #items) or #items
    end
    
    local total = #items
    local antes = contar(STATE.cache)
    local capturados = 0
    
    print("\n🎓 APRENDIZAJE UI: items " .. desde .. " a " .. hasta .. " de " .. total)
    
    -- Si empieza desde 1, limpiar rancho primero
    if desde == 1 then
        print("🧹 Limpiando rancho...")
        local colocadasIniciales = obtenerColocadas()
        for _, c in ipairs(colocadasIniciales) do
            if not STATE.running then break end
            pcall(function() PickupPet:FireServer(c.key) end)
            task.wait(CONFIG.VELOCIDAD_LIMPIEZA)
        end
        task.wait(0.5)
    end
    
    for idx = desde, hasta do
        if not STATE.running or STATE.cancelarEscaneo then break end
        
        local item = items[idx]
        if item then
            local ok, msg = aprenderUnItem(item)
            if ok then
                capturados = capturados + 1
            end
        end
        
        STATE.indiceAprendizaje = idx
        
        -- Guardado incremental
        if idx % CONFIG.GUARDAR_CADA == 0 then
            guardarCache()
            print("   💾 Guardado auto (" .. idx .. "/" .. total .. ") | Cache: " .. contar(STATE.cache))
        end
        
        if onProgress then
            onProgress(idx, total, capturados)
        end
    end
    
    -- Enriquecimiento final
    print("\n📝 Enriqueciendo age/income...")
    pcall(function()
        local count = 0
        for _, obj in ipairs(getgc(true)) do
            count = count + 1
            if count > 50000 then break end
            if count % 500 == 0 then task.wait() end
            
            if type(obj) == "table" then
                pcall(function()
                    local k = obj.key
                    if type(k) == "string" and #k == 36 and STATE.cache[k] then
                        local age = obj.age
                        local inc = obj.income
                        if type(age) == "number" and type(inc) == "number" then
                            STATE.cache[k].age = age
                            STATE.cache[k].income = inc
                        end
                    end
                end)
            end
        end
    end)
    
    guardarCache()
    
    local finalCache = contar(STATE.cache)
    print("\n✅ Completado. Capturados: " .. capturados .. " | Cache: " .. finalCache)
    
    -- Si terminamos todos, resetear índice
    if hasta >= total then
        STATE.indiceAprendizaje = 0
    end
    
    return {
        antes = antes,
        despues = finalCache,
        nuevos = finalCache - antes,
    }
end

