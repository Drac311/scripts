local function obtenerBotonPlaceBest()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local main = pg:FindFirstChild("Main")
    local tracker = main and main:FindFirstChild("PetsTracker")
    return tracker and tracker:FindFirstChild("PlaceBest")
end

local function pulsarPlaceBest()
    local boton = obtenerBotonPlaceBest()
    if not boton then return false end
    local exito = false
    pcall(function()
        if firesignal then
            firesignal(boton.Activated)
            exito = true
        end
    end)
    return exito
end

local function autoEquipar(usarPotencial)
    if STATE.isAutoEquiping or not STATE.running then return end
    STATE.isAutoEquiping = true
    
    local modo = usarPotencial and "POTENCIAL" or "ACTUAL"
    print("\n🔄 [" .. os.date("%H:%M:%S") .. "] Auto-equipando (" .. modo .. ")")
    
    local colocadas = obtenerColocadas()
    local colocadasKeys = {}
    for _, c in ipairs(colocadas) do colocadasKeys[c.key] = true end
    
    local cacheLista = {}
    for key, info in pairs(STATE.cache) do
        if info.name and info.mutation then
            local valor
            if usarPotencial then
                valor = calcularIncomePotencial(info.name, info.mutation)
            else
                valor = calcularIncomeActual(info.name, info.mutation, info.age or 0)
            end
            table.insert(cacheLista, {
                key = key, name = info.name, mutation = info.mutation,
                age = info.age or 0, valor = valor,
            })
        end
    end
    table.sort(cacheLista, function(a, b) return a.valor > b.valor end)
    
    local mejoresN = {}
    for i = 1, math.min(STATE.slots, #cacheLista) do
        table.insert(mejoresN, cacheLista[i])
    end
    
    print("   Keys: " .. contar(STATE.cache) .. " | Colocadas: " .. #colocadas .. " | Slots: " .. STATE.slots)
    
    if #mejoresN == 0 then
        print("   ⚠️ Sin keys")
        STATE.isAutoEquiping = false
        return
    end
    
    local colocadasEnMejores = 0
    for _, m in ipairs(mejoresN) do
        if colocadasKeys[m.key] then colocadasEnMejores = colocadasEnMejores + 1 end
    end
    
    if colocadasEnMejores == #mejoresN and #colocadas == #mejoresN then
        print("   ✅ Ya están las mejores")
        STATE.isAutoEquiping = false
        return
    end
    
    local quitadas = 0
    for _, c in ipairs(colocadas) do
        if not STATE.running then break end
        local estaEnMejores = false
        for _, m in ipairs(mejoresN) do
            if c.key == m.key then estaEnMejores = true break end
        end
        if not estaEnMejores then
            pcall(function() PickupPet:FireServer(c.key) end)
            quitadas = quitadas + 1
            task.wait(0.35)
        end
    end
    if quitadas > 0 then print("   🔻 Quitadas " .. quitadas) task.wait(1) end
    
    local posBase = Vector3.new(0, 0, 0)
    pcall(function()
        local plot = game.Workspace:FindFirstChild("Plots")
        plot = plot and plot:FindFirstChild("Plot")
        if plot then
            local bp = plot:FindFirstChild("Baseplate")
            if bp and bp:IsA("BasePart") then posBase = bp.Position end
        end
    end)
    
    local colocadasAhora = {}
    for _, c in ipairs(colocadas) do
        local esMejor = false
        for _, m in ipairs(mejoresN) do
            if c.key == m.key then esMejor = true break end
        end
        if esMejor then colocadasAhora[c.key] = true end
    end
    
    local puestas = 0
    for i, m in ipairs(mejoresN) do
        if not STATE.running then break end
        if not colocadasAhora[m.key] then
            local offsetX = ((i - 1) % 5) * 8 - 16
            local offsetZ = math.floor((i - 1) / 5) * 8 - 8
            local pos = posBase + Vector3.new(offsetX, 5, offsetZ)
            pcall(function() PlacePet:FireServer(m.key, pos) end)
            puestas = puestas + 1
            task.wait(0.4)
        end
    end
    if puestas > 0 then print("   🔺 Colocadas " .. puestas) end
    
    guardarCache()
    print("   ✅ Completado")
    STATE.isAutoEquiping = false
end

